FLASK_APP=run.py
FLASK_ENV=development
FLASK_RUN_PORT=5001
PORT=5001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/club_db
SECRET_KEY=dev-secret-key-change-in-production
CORS_ORIGINS=*

# --- JWT / cookies ---
JWT_SECRET_KEY=jwt-dev-key-must-be-at-least-32-chars-long
JWT_COOKIE_SECURE=False

# --- Stripe Payments (Test Mode Sandbox) ---
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=
STRIPE_DEFAULT_CURRENCY=inr

# --- Clubeon AI (Google Gemini) ---
# Get your free key from: https://aistudio.google.com
GOOGLE_API_KEY=your_gemini_api_key_here
ASSISTANT_MODEL=google/gemini-3.5-flash-lite

# Flat fee charged per court booking
BOOKING_FEE=500
